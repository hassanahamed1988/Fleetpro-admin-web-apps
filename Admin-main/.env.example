# This app does not require any secrets to run.
# Firebase client config is already committed in firebase-applet-config.json
# and firebase-admin/app initializes using only that project ID
# (see src/lib/firebaseAdmin.ts) — no service account key is needed.
#
# Optional: FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY /
# FIREBASE_DATABASE_ID are only read by two standalone maintenance scripts
# (migrate-sync-passwords.js and clear-db.js), which you run manually from
# your own machine. If you ever need them, export them in your shell before
# running those scripts directly — they are not required to start the app.
